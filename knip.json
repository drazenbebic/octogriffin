{
  "$schema": "https://unpkg.com/knip@next/schema.json",
  "workspaces": {
    "apps/web": {
      "entry": [
        "src/utils/cn.ts",
        "jest.config.ts",
        "jest.setup.ts",
        "src/**/*.test.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "jest": false,
      "ignoreDependencies": [
        "@prisma/client",
        "@types/pg",
        "@typescript-eslint/utils",
        "husky",
        "jest-environment-jsdom",
        "pg",
        "pino-pretty",
        "tailwindcss",
        "typescript-eslint"
      ],
      "ignoreBinaries": ["ngrok"]
    },
    "apps/api": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["tsx"]
    }
  },
  "ignoreExportsUsedInFile": true
}
